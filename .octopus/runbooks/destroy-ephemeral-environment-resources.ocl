name = "Destroy Ephemeral Environment Resources"
default_guided_failure_mode = "EnvironmentDefault"
description = "Destroys the namespace created by Ephemeral Environments."

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {
    step "get-database-password" {
        name = "Get database password"

        action {
            properties = {
                Octopus.Action.Template.Id = "ActionTemplates-5241"
                Octopus.Action.Template.Version = "9"
                Vault.Retrieve.KV.V2.Secrets.ApiVersion = "v1"
                Vault.Retrieve.KV.V2.Secrets.AuthToken = "#{HashiCorp.Vault.Auth.Token}"
                Vault.Retrieve.KV.V2.Secrets.FieldValues = "SA_PASSWORD | SA_PASSWORD"
                Vault.Retrieve.KV.V2.Secrets.PrintVariableNames = "True"
                Vault.Retrieve.KV.V2.Secrets.RecursiveSearch = "False"
                Vault.Retrieve.KV.V2.Secrets.RetrievalMethod = "Get"
                Vault.Retrieve.KV.V2.Secrets.SecretsPath = "/secret/mysqlserver"
                Vault.Retrieve.KV.V2.Secrets.VaultAddress = "#{HashiCorp.Vault.Server.Url}"
            }
            worker_pool = "linux-worker-pool"
        }
    }

    step "mysql-execute-command-copy" {
        name = "MySQL - Execute Command Copy"

        action {
            properties = {
                mySqlAuthenticationMethod = "usernamepassword"
                mySqlCommand = "DROP DATABASE `#{Project.Database.Name}`;"
                mySqlDatabaseName = "#{Project.Database.Name}"
                mySqlPassword = "#{Octopus.Action[Get database password].Output.SA_PASSWORD}"
                mySqlServerName = "#{MySQL.Server.Name}"
                mySqlServerPort = "3306"
                mySqlTrustSSL = "False"
                mySqlUsername = "#{MySQL.Database.Admin.Username}"
                Octopus.Action.Template.Id = "ActionTemplates-7881"
                Octopus.Action.Template.Version = "2"
            }
            worker_pool = "default-worker-pool"
        }
    }

    step "mysql-drop-database" {
        name = "MySQL - Drop database"

        action {
            is_disabled = true
            properties = {
                mySqlAuthenticationMethod = "usernamepassword"
                mySqlCommand = "DROP DATABASE `#{Project.Database.Name}`;"
                mySqlDatabaseName = "#{Project.Database.Name}"
                mySqlPassword = "#{Octopus.Action[Get database password].Output.SA_PASSWORD}"
                mySqlServerName = "#{MySQL.Server.Name}"
                mySqlServerPort = "3306"
                mySqlTrustSSL = "False"
                mySqlUsername = "#{MySQL.Database.Admin.Username}"
                Octopus.Action.Template.Id = "ActionTemplates-7861"
                Octopus.Action.Template.Version = "3"
            }
            worker_pool = "database-worker-pool"
        }
    }

    step "delete-branch-namespace" {
        name = "Delete branch namespace"
        properties = {
            Octopus.Action.TargetRoles = "Octopub-Audit"
        }

        action {
            action_type = "Octopus.KubernetesRunScript"
            properties = {
                Octopus.Action.Script.ScriptBody = <<-EOT
                    # Set varaibles
                    $clusterNamespace = "#{Octopus.Environment.Name | ToLower}"
                    
                    # Get existing namespaces
                    Write-Host "Retrieving namespaces ..."
                    $namespaces = (kubectl get namespaces -o JSON | ConvertFrom-Json)
                    
                    # Check to see if namespace exists
                    if ($null -ne ($namespaces.Items | Where-Object {$_.metadata.name -eq $clusterNamespace}))
                    {
                    	# Create the namespace
                        Write-Host "Deleting namespace $clusterNamespace ..."
                        kubectl delete namespace $clusterNamespace
                    }
                    else
                    {
                    	Write-Host "Namespace $clusterNamespace doesn't exists, moving on ..."
                    }
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
                OctopusUseBundledTooling = "False"
            }
            worker_pool = "container-worker-pool"

            container {
                feed = "docker-hub"
                image = "octopusdeploy/worker-tools:ubuntu.22.04"
            }
        }
    }
}